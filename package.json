{
  "name": "fuma-scaffold",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "sync:docs": "node scripts/normalize_log.mjs && node scripts/build_knowledge_loop.mjs && node scripts/build_promotion_index.mjs && node scripts/migrate_to_fumadocs.mjs",
    "build:knowledge-loop": "node scripts/build_knowledge_loop.mjs",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "verify:log": "node scripts/verify_log_gate.mjs",
    "generate:mandalart-nav": "node scripts/mandalart_navigation.mjs generate",
    "verify:mandalart-nav": "node scripts/mandalart_navigation.mjs verify"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.8.5",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-ui": "16.8.5",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.10",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
